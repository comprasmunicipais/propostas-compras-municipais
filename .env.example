NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Valores reais devem ser configurados localmente ou na Vercel.
# Nenhuma senha deve ser inserida no arquivo versionado.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true normalmente e usado quando o servidor exige TLS direto.
SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true solicita STARTTLS quando aplicavel.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Compras Municipais
REVISTA_ACCEPTANCE_NOTIFICATION_EMAIL=
